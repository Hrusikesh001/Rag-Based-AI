\u092c\u0941\u0915 \u092e\u093e\u0915 \u091c\u093e\u090f\u0917\u093e \u092f\u0939\u093e\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 284.40000000000003, "end": 289.76000000000005, "text": " \u0915\u093f \u092f\u0939 \u0924\u094b \u0924\u0948\u0939 \u0939\u0948 \u0915\u093f \u0938\u093f\u0917\u094d\u092e\u093e \u0915\u094c\u0930\u094d\u0938 \u092c\u0921\u093c\u093f\u092f\u093e \u092a\u094d\u0930\u0940 \u0915\u094c\u0930\u0938 \u0906\u092a\u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 289.76000000000005, "end": 293.76000000000005, "text": " \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0947 \u0932\u094b\u0917 \u0907\u0938\u0915\u0940 \u0924\u093e\u0930\u0940\u092b\u0947 \u0915\u0930 \u0930\u0939\u0947\u0902 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092c\u0939\u0941\u0924 \u092a\u094d\u092f\u093e\u0930 \u0926\u093f\u092f\u093e \u0939\u0948"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 293.76, "end": 297.76, "text": " \u0932\u0947\u0915\u093f\u0928 \u0907\u0902\u0921\u0949\u0938\u094d\u091f\u094d\u0930\u0940 \u0915\u0947 \u0915\u0941\u091b \u0932\u094b\u0917 \u0939\u0948\u0902 \u091c\u094b \u0915\u0940 \u0938\u093f\u0917\u092e\u093e \u0915\u094b\u0930\u094d\u0938 \u0915\u0947 \u092b\u0930\u0940 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0916\u0941\u0936 \u0928\u0939\u0940\u0902 \u0939\u0948"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 297.76, "end": 303.26, "text": " \u092e\u0948\u0902\u0928\u0947 \u0906\u092a\u0938\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940 \u0915\u0939\u093e\u0924\u093e \u0914\u0930 \u092e\u0948\u0902 \u0906\u092a\u0938\u0947 \u0905\u092c \u092d\u0940 \u0915\u0939\u0941\u0902\u0917\u093e \u0915\u093f \u092e\u0948\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0924\u0930\u0939 \u0915\u0947 \u092a\u0947\u0921\u093c \u0915\u094b\u0930\u094d\u0938 \u0915\u0947 \u0916\u093f\u0932\u093e\u092b \u0928\u0939\u0940\u0902 \u0939\u0942\u0901"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 303.26, "end": 311.26, "text": " \u0932\u0947\u0915\u093f\u0928 \u0938\u093f\u0917\u092e\u093e \u090f\u0915 \u092c\u0939\u0941\u0924 \u0916\u0924\u0930\u0928\u093e\u0915 HTML, CSS, JavaScript, Web Development \u0915\u093e \u090f\u0915 \u090f\u0915 \u092c\u0939\u0941\u0924 \u0916\u0924\u0930\u0928\u093e\u0915 \u0915\u094b\u0930\u094d\u0938 \u0939\u0948"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 311.26, "end": 316.26, "text": " \u092f\u0939 \u0924\u094b \u092f\u093e\u0930 \u0915\u094b\u0908 \u0921\u093f\u0928\u093e\u0907 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e \u092f\u0939 \u090f\u0915 \u092c\u0939\u0941\u0924 \u0939\u0940 \u090f\u0915 \u092a\u0930\u0935\u093e\u0930\u0924\u093e \u0925\u093e"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 316.26, "end": 322.26, "text": " \u0914\u0930 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092c\u0941\u0930\u093e \u092d\u0940 \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u093e\u0930 \u092e\u0948\u0902\u0928\u0947 paid \u0916\u093c\u0924\u0940 \u0932\u093f\u092f\u093e \u0925\u093e \u0915\u094b\u0930\u094d\u0938 \u092a\u0939\u0932\u0947 \u0905\u092c \u092f\u093e\u0930 \u092b\u0930\u0940 \u092e\u0947\u0902 \u0907\u0924\u0928\u093e \u092c\u0921\u093c\u093f\u092f\u093e \u0915\u094b\u0930\u094d\u0938 \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 322.26, "end": 327.26, "text": " \u0924\u094b \u0915\u091f\u093f\u092f\u093e \u0932\u094b\u0938\u0947\u091c \u0914\u0930 \u0915\u0930\u094b \u0907\u0938\u0915\u094b \u0914\u0930 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0947 \u0932\u094b\u0917 \u092e\u0947\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0940 \u092c\u093e\u0924\u0947 \u0907\u0924\u0930 \u0909\u0924\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902"}, {"number": "29", "title": "Exercise 3 - Design this Card ", "start": 357.26, "end": 377.26, "text": " \u0935\u093f\u091f\u0940\u092c \u0913\u0930\u093f\u091c\u093f\u0928\u0932\u094d\u0938"}], "text": " \u091c\u0948\u0938\u0947 \u092f\u093e \u0907\u0938 \u0917\u094b\u0930\u094d\u0938 \u092e\u0947\u0902 \u0939\u092e \u0932\u094b\u0917 \u0906\u0917\u0947 \u092c\u0922\u093c\u0924\u0947 \u091c\u093e\u090f\u0902\u0917\u0947, \u092e\u0948\u0902 \u0924\u094b\u0921\u093c\u093e \u0938\u093e \u0932\u0947\u0935\u0932 \u092c\u0922\u093c\u093e\u0924\u093e \u091c\u093e\u0913\u0902\u0917\u093e. \u092e\u0948\u0902\u0928\u0947 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 \u0915\u0939\u093e \u0925\u093e, \u090f\u0915\u0938\u0947\u0938\u093e\u0908\u0938 \u0924\u094d\u0930\u0940 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0939\u092e \u090f\u0915 \u0910\u0938\u0940 \u091a\u0940\u091c \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902, \u091c\u094b \u0915\u093f \u0906\u0915\u094d\u0936\u0949\u0932 \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u092e\u093e\u0932 \u0939\u094b\u0917\u0940. \u092f\u093e\u0928\u093f \u0915\u093f \u0907\u0938 \u0924\u0930\u0939 \u0915\u0940 \u091a\u0940\u091c\u093c\u0947 \u0906\u092a \u0932\u094b\u0917 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b \u092c\u093f\u0932\u094d\u0921 \u0915\u0930\u0924\u0947 \u0939\u0941\u0902\u0901 \u0926\u0947\u0916\u094b\u0917\u0947, \u091c\u092c \u0906\u092a \u090f\u0915\u094d\u0936\u0949\u0932 \u0915\u094d\u0932\u093e\u0907\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u0947\u092a\u0938\u093e\u0907\u091f \u092c\u093f\u0932\u094d\u0921 \u0915\u0930\u094b\u0917\u0947 \u0924\u094b. \u0905\u0917\u0930 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0921\u093f\u0938\u093e\u0907\u091f \u0915\u0930 \u0932\u093f\u092f\u093e \u0915\u093f \u0906\u092a \u0932\u094b\u0917 \u0907\u0938 \u0915\u094d\u0935\u093e\u0938\u093f\u092f\u0928 \u0915\u094b \u0938\u094c\u0932\u094d\u092a \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902, \u0924\u094b \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091a\u0948\u0932\u0947\u0902\u091c \u090f\u0915\u094d\u0938\u092a\u094d\u091f\u0947\u091f \u091c\u0930\u0942\u0930 \u0932\u093f\u0916 \u0926\u0947\u0928\u093e. \u092e\u0948\u0902 \u0924\u094b \u092f\u093e\u0930 \u0939\u092e\u0947\u0936\u093e \u0915\u0940 \u0926\u0930\u0939 \u092c\u0939\u0941\u0924 \u091c\u093c\u092c\u093e\u0908 \u090f\u0915\u094d\u0938\u093e\u0907\u091f\u0947\u091f \u0939\u0942\u0901, \u0907\u0938 \u090f\u0915\u094d\u0938\u0947\u0938\u093e\u0907\u0938 \u0915\u094b \u0932\u0947\u0915\u0930 \u092d\u0940 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f\u0938\u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u0939\u0948 \u0926\u092e, \u0932\u0947\u091f\u0938 \u0932\u094b \u0926\u0947 \u0907\u0902\u091f\u094d\u0930\u094b! \u0906\u091c \u0915\u093e \u0926\u0947\u0916\u094b \u091c\u094b \u092e\u0941\u0926\u094d\u0927\u093e \u0939\u0948, \u091c\u094b \u091f\u0949\u092a\u093f\u0915 \u0939\u0948 \u0906\u091c \u0915\u0947 \u0935\u093f\u0921\u093f\u092f\u094b \u0915\u093e, \u0909\u0938\u0915\u094b \u0906\u092a \u0932\u094b\u0917 \u092e\u093e\u0930\u094d\u0915 \u0915\u0930 \u0932\u094b, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u091c \u0939\u092e \u090f\u0915\u094d\u0936\u0949\u0932 \u092e\u0947\u0902 \u0915\u0941\u091b \u092c\u0939\u0941\u0924 \u092e\u091c\u093c\u0947\u0926\u093e\u0930 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902, \u090f\u0915\u094d\u0936\u0949\u0932 \u0921\u0935\u0932\u092c\u094d\u092e\u0947\u0902\u091f \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0947\u0902\u0917\u0947, \u092e\u0948\u0902 \u0906\u092a \u0932\u094b\u0917 \u0915\u094b \u092f\u0939\u093e\u0901 \u092a\u0930 \u090f\u0915 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u092a\u093f\u092f\u0902\u091c\u0940 \u0926\u093f\u0916\u093e\u090a\u0902\u0917\u093e, \u0914\u0930 \u0906\u092a\u0915\u094b \u092f\u0939 \u0915\u093e\u0930\u094d\u0921 \u092c\u0928\u093e\u0928\u093e \u0939\u0948, \u092f\u0939\u0940 \u0906\u091c \u0915\u0940 \u090f\u0915\u094d\u0938\u0930\u0938\u093e\u0907\u0938 \u0939\u0948, \u091c\u093c\u093e\u0927\u093e \u0932\u093f\u0916\u093e \u092c\u0921\u093c\u0940 \u092e\u0948\u0902 \u092f\u0939\u093e\u0901 \u092a\u0930 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0942\u0901, \u0932\u0947\u0915\u093f\u0928 \u091a\u0932\u094b \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0942\u0901 \u092f\u093e\u0930, \u092a\u0930 \u0935\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0906\u092a\u0915\u094b \u092f\u0939\u093e\u0901 \u092a\u0930 \u0926\u0947\u0916\u093e\u0901, \u092e\u0948\u0902 \u0935\u0940\u090f\u0938 \u0915\u094b\u0921 \u092e\u0947\u0902 \u0907\u0938 \u092b\u094b\u0932\u094d\u091f\u0930 \u0915\u094b \u0916\u0941\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901, \u0924\u094b \u0936\u093f\u092b\u094d\u091f \u0930\u093e\u0907\u091f \u0932\u093f\u0916 \u0915\u0930\u0915\u0947 \u090f\u0915 \u090f\u0902\u0921\u093f\u0915\u094d\u0938 \u091f\u094b\u0921 \u090f\u0915 \u091f\u0940 \u0905\u092e\u0932 \u0917\u0930\u0942\u0901\u0917\u093e, \u0914\u0930 \u090f\u0915 \u092c\u0949\u0907\u0932\u0930 \u092a\u094d\u0932\u0947\u091f \u0921\u093e\u0932\u0915\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0915\u0949\u092e\u0947\u0902\u091f \u092c\u0928\u093e\u0913\u0902\u0917\u093e, \u0906\u092a\u0915\u094b \u090f\u0915 \u0915\u0949\u092e\u0947\u0902\u091f \u0921\u093e\u0932\u0942\u0902\u0917\u093e, \u0915\u093e\u0930\u094d\u0921 \u0921\u0949\u091f \u092a\u0940 \u090f\u0902\u0917\u0940 \u0907\u0938 \u092b\u0949\u0932\u094d\u091f\u0930 \u0915\u094b \u0916\u0941\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901, \u092a\u0930 \u0935\u093e\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0906\u092a\u0915\u094b \u092f\u0939\u093e\u0901 \u092a\u0930 \u0926\u0947\u0916\u093e\u0901, \u092e\u0948\u0902 \u0935\u0940\u090f\u0938 \u0915\u094b\u0921 \u092e\u0947\u0902 \u0907\u0938 \u092b\u094b\u0932\u094d\u091f\u0930 \u0915\u094b \u0916\u0941\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901, \u0924\u094b \u0936\u093f\u092b\u094d\u0930 \u0930\u093e\u0907\u091f \u0932\u093f\u0916 \u0915\u0930\u0915\u0947 \u090f\u0902\u0921\u093f\u0915\u094d\u0938 \u091f\u094b\u0921 \u090f\u0915 \u090f\u0902\u0921\u093f\u0915 \u092a\u0930 \u0906\u092a\u0915\u094b \u0917\u092c\u093e\u0926 \u0939\u0948, \u092e\u0941\u091d\u0947 \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0937\u0928 \u092e\u0947\u0902 \u092c\u0924\u093e\u0913, \u0926\u0947\u0916\u094b \u092f\u0939 \u0907\u092e\u0947\u091c \u0915\u0947 \u091c\u0917\u093e\u0901 \u0906\u092a \u0915\u094b\u0908 \u0938\u0940\u092c\u0940 \u0907\u092e\u0947\u091c \u092f\u0942\u091c\u093c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b, \u0920\u0940\u0915 \u0939\u0948, \u0914\u0930 \u092e\u0941\u091d\u0947 \u090f\u0915\u094d\u091c\u093e\u0915\u0932\u0940 \u092f\u0939\u0940 \u0915\u093e\u0930\u094d\u0921 \u091a\u093e\u0939\u093f\u090f \u092c\u093f\u0926\u093e \u0915\u0949\u092e\u092a\u0930\u092e\u093e\u0907\u091c \u0915\u0947, \u092f\u0939 \u0915\u093e\u0930\u094d\u0921 \u0915\u0940 \u0907\u092e\u0947\u091c \u091c\u094b \u0939\u0948, \u0935\u094b \u090f\u0915 \u0907\u092e\u0947\u091c \u0939\u0948, \u0906 \u092a\u093e\u0930 \u092a\u0930 \u0906\u092a\u0915\u094b \u0926\u093f\u0938\u0915\u094d\u0935\u093e\u0932\u093f\u092b\u093e\u0908 \u0915\u0930 \u0926\u0942\u0901\u0917\u093e \u0906\u092a\u0915\u094b, \u0920\u0940\u0915 \u0939\u0948 \u0924\u094b \u0905\u0917\u0930 \u0906\u092a\u0932\u094b\u0917 \u0926\u093f\u0938\u0915\u094d\u0935\u093e\u0932\u093f\u092b\u093e\u0908 \u0928\u0939\u0940\u0902 \u0939\u094b\u0928\u093e \u091a\u093e\u0924\u0947 \u0939\u094b, \u0924\u094b \u0905\u091a\u094d\u091b\u0947 \u0938\u0947 \u092c\u0928\u093e\u0928\u093e \u092c\u0922\u093c\u093f\u092f\u093e\u0938 \u0915\u0930\u0928\u093e \u0920\u0940\u0915 \u0939\u0948, \u0905\u0917\u0930 \u092c\u0922\u093c\u093f\u092f\u093e\u0938 \u0915\u0930\u094b\u0917\u0947 \u0924\u094b \u0906\u092a\u0915\u094b \u0938\u094d\u091f\u094d\u0930\u093e\u091f \u092d\u0940 \u092e\u093f\u0932\u0947\u0917\u093e \u0905\u092c \u0926\u0947\u0916\u094b \u092f\u0939\u093e\u0901 \u092a\u0930 \u0932\u0948\u0915 \u0914\u0930 \u0921\u0940 \ufffd \u0925\u0940\u0915 \u0939\u0948, \u0939\u0947\u0937\u094d\u091f\u0947\u0917 HTML, \u0906\u091c \u0915\u093e \u0939\u0947\u0937\u094d\u091f\u0947\u0917 \u0939\u0948 \u0939\u0947\u0937\u094d\u091f\u0947\u0917 HTML, \u0939\u0947\u0937\u094d\u091f\u0947\u0917 HTML \u092f\u0942\u0938\u093f \u0915\u0930\u0915\u0947 \u0906\u092a\u0932\u094b\u0917 \u0905\u092a\u0928\u093e \u0938\u0949\u0932\u0942\u0936\u0928 \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u093e \u0924\u093e\u0915\u093f \u092e\u0948\u0902 \u0938\u0930\u094d\u091a \u0915\u0930 \u0932\u094b \u0907\u0938 \u0939\u0947\u0937\u094d\u091f\u0947\u0917 \u0938\u0947 \u0914\u0930 \u092e\u0941\u091d\u0947 \u092a\u0924\u093e \u091a\u0932 \u091c\u093e\u090f\u0917\u0940 \u0906\u092a\u0928\u0947 \u0907\u0938 \u092a\u094d\u0930\u093e\u092c\u0932\u092e \u0915\u093e \u0938\u0949\u0932\u0942\u0936\u0928 \u0935\u094b \u092a\u094b\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u0939\u0941\u0906 \u0905\u092c \u091a\u0932\u094b \u0925\u094b\u0921\u093c\u093e \u0921\u093f\u0938\u0915\u0930\u094d\u0936\u0928 \u0915\u0930\u0924\u093e \u0939\u0942\u0902 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u091c\u094b \u0932\u094b\u0917 \u0926\u0947\u0916\u0915\u0930 \u0939\u093f\u092e\u093e\u0930\u0940 \u0930\u0942\u0921 \u0917\u0908 \u0939\u0948 \u0909\u0928\u0915\u0940 \u092f\u093e\u0930 \u0907\u0938 \u0915\u0948\u0938\u0947 \u092c\u0928\u0947\u0917\u093e \u092e\u0948\u0902 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u0924\u093e \u0939\u0942\u0902 \u0906\u092a \u092e\u0947\u0930\u0947 \u0938\u093e\u0925 \u0930\u0939\u094b \u0907\u0938 \u090f\u0915\u094d\u0938\u0930\u0938\u093e\u0907\u0938 \u0915\u094b \u0928\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092c\u0947\u0925\u0930 \u092e\u0941\u091d\u0947 \u0938\u0941\u0928\u094b \u0932\u0947\u0915\u093f\u0928 \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u091a\u0932\u0947\u0902\u091c \u090f\u0915\u0938\u0947\u092a\u094d\u091f \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948 \u0924\u094b \u0906\u092a \u092c\u093f\u0928\u093e \u0938\u0941\u0928\u0947 \u0939\u0940 \u0907\u0938\u0915\u094b \u0915\u0930\u0928\u093e \u0939\u094b \u0938\u0915\u0947 \u0924\u094b \u0906\u092a \u0932\u094b\u0917 \u0907\u0938 solution \u0915\u094b \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0941\u0928 \u0932\u0947\u0928\u093e \u092e\u0947\u0930\u0940 \u092c\u093e\u0924 \u0915\u094b \u0926\u0947\u0916\u094b \u092f\u0939\u093e\u0902 \u092a\u0930 \u0906\u092a \u0932\u094b\u0917 \u0926\u0947\u0916\u094b \u0915\u093f \u090f\u0915 \u092e\u0948\u0902\u0928\u0947 \u0921\u093f\u0935 \u092c\u0928\u093e \u0926\u093f\u092f\u093e \u0939\u0948 \u092a\u0930 \u092e\u093e\u0928\u0932\u094b \u0920\u0940\u0915 \u0939\u0948 \u0909\u0938\u092e\u0947\u0902 \u0926\u0947 \u0926\u0942\u0901\u0917\u093e \u092e\u0948\u0902 border radius \u0915\u093f\u0924\u0928\u0940 border radius \u0926\u0947\u0928\u0940 \u0939\u0948 \u0935\u094b \u0926\u0947\u0916 \u0932\u0947\u0928\u093e \u0909\u0938 \u0921\u093f\u0935 \u0915\u094b \u090f\u0915 set height \u0906\u092a \u0932\u094b\u0917 \u0926\u0947 \u092d\u0940 \u0938\u0915\u0924\u0947 \u0939\u094b \u0928\u0939\u0940\u0902 \u092d\u0940 \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u094b \u092e\u0948\u0902 \u092a\u0924\u093e\u0924\u093e \u0939\u0942\u0902 \u0915\u094d\u092f\u093e \u092c\u0924\u0932\u092c \u0939\u094b \u0907\u0938 \u092c\u093e\u0924 \u0915\u093e \u0920\u0940\u0915 \u0939\u0948 \u092f\u0939 \u092e\u0948\u0902\u0928\u0947 \ufffd \u0921\u093f\u0935 \u0926\u0947 \u0926\u0942\u0901\u0917\u093e \u0925\u094b \u0928\u0939\u0940\u0902 \u0926\u0947 \u0926\u0942\u0901\u0917\u093e \u0924\u094b \u092a\u0924\u093e\u0924\u093e \u0939\u0948 \u092f\u0939 \u0907\u0938\u0915\u0947 \u0905\u0902\u0926\u0930 \u0906 \u091c\u093e\u090f\u0917\u093e \u0907\u0938\u0915\u0947 \u092c\u093e\u0924 \u092f\u0939 \u0921\u093f\u0935 \u092f\u0939\u093e\u0902 \u092a\u0930 \u0916\u093c\u0924\u092e \u0939\u094b \u0917\u093f\u092f\u093e \u0939\u0948 \u090f\u0915 \u0921\u093f\u0935 \u0915\u0947 \u0905\u0902\u0926\u0930 \u0921\u093f\u0935 \u0921\u093e\u0932\u0942\u0917\u093e \u090f\u0915 \u0926\u0942\u0938\u0930 \u0921\u093f\u0935 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0942\u0901\u0917\u093e \u091c\u093f\u0938\u092e\u0947\u0902 \u0928\u0947\u091a\u0930 \u0914\u0930 \u0932\u0947\u0915 \u0935\u093e\u0932\u0940 \u092f\u0939 \u090f\u0915 \u090f\u0915 \u0906\u092a\u0938\u0942\u0932 \u092c\u0928\u093e\ufffd \u092b\u093f\u0930 \u090f\u0915 \u0914\u0930 \u0921\u093f\u0935 \u0932\u0917\u093e\u090a\u0902\u0917\u093e \u091c\u093f\u0938\u0915\u0947 \u0905\u0902\u0926\u0930 \u092e\u0948\u0902 \u090f\u0915 \u092c\u091f\u0928 \u0921\u093e\u0932\u0942\u0901\u0917\u093e \u0909\u0938 \u0921\u093f\u0935 \u0915\u0947 \u0905\u0902\u0926\u0930 \u092e\u0948\u0902 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0932\u093e\u0907\u0928 \u0938\u0947\u0902\u091f\u0930 \u0915\u0930\u0926\u0942\u0902\u0917\u093e \u0924\u093e\u0915\u093f \u092f\u0939 \u0938\u0947\u0902\u091f\u0930 \u0939\u094b \u091c\u093e\u090f \u0914\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u0940\u0921\u093f\u092f\u094b\u091c \u092e\u0947\u0902 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0907\u0938\u0915\u093e \u0938\u094c\u0932\u0942\u0936\u0928 \u092e\u093f\u0932 \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0939\u0940\u0930\u094b\u0938 \u0915\u094b \u0936\u093e\u0949\u091f \u0906\u0909\u091f \u092d\u0940 \u0926\u0942\u0902\u0917\u093e \u091c\u093f\u0928 \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0907\u0938 \u092a\u094d\u0930\u093e\u092c\u094d\u0932\u0942\u092e \u0915\u094b \u0938\u094c\u0932\u094d\u0935 \u0915\u093f\u092f\u093e \u0939\u094b\u0917\u093e \u0905\u0917\u0930 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u090f\u0915\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0941\u0906 \u0938\u093f\u0917\u092e\u093e \u0935\u0947\u092c \u0921\u0935\u0932\u092c\u094d\u092e\u0947\u0902\u091f \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u0915\u094b \u0924\u094b \u0906\u092a\u0932\u094b\u0917 \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 \u091c\u094b \u090f\u0915 \u092c\u0941\u0915 \u092e\u093e\u0915 \u091c\u093e\u090f\u0917\u093e \u092f\u0939\u093e\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901 \u0915\u093f \u092f\u0939 \u0924\u094b \u0924\u0948\u0939 \u0939\u0948 \u0915\u093f \u0938\u093f\u0917\u094d\u092e\u093e \u0915\u094c\u0930\u094d\u0938 \u092c\u0921\u093c\u093f\u092f\u093e \u092a\u094d\u0930\u0940 \u0915\u094c\u0930\u0938 \u0906\u092a\u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0947 \u0932\u094b\u0917 \u0907\u0938\u0915\u0940 \u0924\u093e\u0930\u0940\u092b\u0947 \u0915\u0930 \u0930\u0939\u0947\u0902 \u0906\u092a \u0932\u094b\u0917\u094b\u0902 \u0928\u0947 \u092c\u0939\u0941\u0924 \u092a\u094d\u092f\u093e\u0930 \u0926\u093f\u092f\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u090