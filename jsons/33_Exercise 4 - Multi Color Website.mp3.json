{"chunks": [{"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 0.0, "end": 4.32, "text": " \u0906\u091c \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f\u0938 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u0939\u0948 \u0926\u092e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0947 \u0905\u0902\u0926\u0930 \u092e\u0948\u0902 \u0906\u092a \u0932\u094b\u0917\u094b \u0915\u094b \u091c\u0941\u0924\u0928\u0947 \u092d\u0940"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 4.32, "end": 8.64, "text": " \u0917\u0949\u0902\u0938\u0930\u094d\u092a\u094d\u0938 \u0939\u092e\u0928\u0947 \u0938\u093f\u0917\u092e\u093e \u0935\u0948\u092a \u0921\u0935\u0932\u092a\u094d\u092a\u0947\u0902\u0921 \u0915\u094b\u0921\u0938 \u092e\u0947\u0902 \u0938\u0940\u0916\u0947\u0902 \u0909\u0928 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u090f\u0915 \u090f\u0915\u0938\u0938\u093e\u0907\u0938 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0942\u0901"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 8.64, "end": 14.040000000000001, "text": " \u091c\u094b \u0906\u092a \u0932\u094b\u0917\u094b \u0915\u094b \u0938\u0949\u0932\u094d\u0935 \u0915\u0930\u0928\u0940 \u0939\u0948 \u0914\u0930 \u0905\u0917\u0930 \u0906\u092a \u0932\u094b\u0917\u094b \u0928\u0947 \u0925\u093e\u0928 \u0932\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0909\u0938 \u0915\u094d\u0935\u0948\u0938\u094d\u091a\u0928 \u0915\u094b \u0938\u0949\u0932\u094d\u0935 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 14.040000000000001, "end": 18.16, "text": " \u0924\u094b \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0932\u093f\u0916 \u0926\u094b \u091a\u0948\u0932\u0947\u0902\u091c \u090f\u0915\u0938\u093e\u092b\u094d\u091f\u0947\u091f \u0938\u092c \u0932\u094b\u0917 \u0932\u093f\u0916 \u0926\u0947 \u0928 \u0926\u0947\u0916\u094b"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 18.16, "end": 26.48, "text": " \u0914\u0930 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u0932\u093e\u0907\u0915 \u092d\u0940 \u0915\u0930 \u0926\u0947\u0928\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0947\u0930\u0940 \u0907\u0928\u0930\u091c\u0940 \u0924\u094b \u0939\u093e\u0908 \u0939\u0948 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u0932\u0924\u0947 \u0939\u0948\u0902 \u0915\u0949\u092e\u094d\u092a\u094d\u092f\u0942\u091f\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u092e \u092e\u0947\u0902 \u0932\u0947\u091f\u094d\u0938 \u0930\u094b\u0932 \u0926\u0947 \u0907\u0902\u091f\u094d\u0930\u094b"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 26.48, "end": 56.24, "text": " \u0906\u092a\u0915\u094b \u092c\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091a\u0932\u0947\u0902\u091c \u090f\u0915\u0938\u093e\u092b\u094d\u091f\u0947\u091f \u0932\u093f\u0916\u0947\u0917\u093e"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 86.24, "end": 116.24, "text": " \u0906\u092a\u0915\u094b \u092c\u0928\u093e\u0928\u093e \u0939\u0948 \u0907\u0938 \u092c\u0949\u0932\u094d\u091f\u0940 \u0915\u0932\u0930 \u0928\u0947\u0935\u093e\u092c\u093e\u0930 \u0915\u094b \u092c\u0928\u093e\u0928\u093e \u0939\u0948 \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901 \u092d\u0940 \u092f\u0939\u093e\u0902 \u092a\u0930 \u0915\u093f \u0939\u092e \u0926\u093f\u0930\u0947 \u0926\u093f\u0930\u0947 \u091f\u094d\u0930\u0936\u093f\u0936\u0928 \u0915\u0930\u0947\u0902\u0917\u0947 \u090f\u0915 \u092b\u0941\u0932 \u0935\u0947\u092c\u0938\u093e\u0907\u0921 \u092c\u0928\u093e\u0928\u0947 \u092a\u0930 \u0915\u0941\u091b \u0907\u0902\u092a\u094b\u0930\u094d\u091f\u0947\u0902\u091f \u0915\u0949\u0902\u0938\u0947\u092a\u094d\u091f \u0938\u0947 \u0935\u094b \u0915\u092c\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u091c\u0948\u0938\u0947 \u0915\u0940 \u092b\u094d\u0932\u0947\u0915\u094d\u0938 \u092c\u0949\u0915\u094d\u0938 \u0939\u094b \u0917\u092f\u093e \u0939"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 116.24, "end": 146.24, "text": " \u0935\u093e\u0932\u093e \u092a\u0930 \u0906\u092a\u0915\u094b \u0926\u094b\u0908 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0905\u092a\u0928\u0947 \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u0906\u0916\u094d\u0938\u0947\u0938 \u0915\u0930 \u0932\u093f\u090f \u0939\u0948 \u0914\u0930 \u091c\u094b \u0938\u094b\u0930\u094d\u0938 \u0915\u094b\u0921 \u092c\u094b \u092c\u0940 \u0905\u092a\u0932\u094b\u0921 \u0939\u094b\u0924\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948 \u0924\u094b \u0909\u0938\u0915\u094b \u092d\u0940 \u0906\u092a \u0932\u094b\u0917 \u0906\u0916\u094d\u0938\u0947\u0938 \u091c\u093c\u0930\u0942\u0930 \u0915\u0930 \u0932\u0947\u0928\u093e \u0905\u092d\u0940 \u0917\u0932\u0947\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u0917\u0948\u0938 \u0924\u0947\u0902\u0915\u093f\u092f\u094b \u0938\u094b \u092e\u0941\u091d \u0917\u0948\u0938 \u092a\u0930 \u0935\u093e\u091a\u093f\u0902\u0917 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f"}, {"number": "33", "title": "Exercise 4 - Multi Color Website", "start": 146.24, "end": 150.24, "text": " \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"}], "text": " \u0906\u091c \u0926\u0947\u0916\u0947\u0902\u0917\u0947 \u0915\u093f\u0938 \u092e\u0947\u0902 \u0915\u093f\u0924\u0928\u093e \u0939\u0948 \u0926\u092e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0947 \u0905\u0902\u0926\u0930 \u092e\u0948\u0902 \u0906\u092a \u0932\u094b\u0917\u094b \u0915\u094b \u091c\u0941\u0924\u0928\u0947 \u092d\u0940 \u0917\u0949\u0902\u0938\u0930\u094d\u092a\u094d\u0938 \u0939\u092e\u0928\u0947 \u0938\u093f\u0917\u092e\u093e \u0935\u0948\u092a \u0921\u0935\u0932\u092a\u094d\u092a\u0947\u0902\u0921 \u0915\u094b\u0921\u0938 \u092e\u0947\u0902 \u0938\u0940\u0916\u0947\u0902 \u0909\u0928 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u090f\u0915 \u090f\u0915\u0938\u0938\u093e\u0907\u0938 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u0942\u0901 \u091c\u094b \u0906\u092a \u0932\u094b\u0917\u094b \u0915\u094b \u0938\u0949\u0932\u094d\u0935 \u0915\u0930\u0928\u0940 \u0939\u0948 \u0914\u0930 \u0905\u0917\u0930 \u0906\u092a \u0932\u094b\u0917\u094b \u0928\u0947 \u0925\u093e\u0928 \u0932\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0909\u0938 \u0915\u094d\u0935\u0948\u0938\u094d\u091a\u0928 \u0915\u094b \u0938\u0949\u0932\u094d\u0935 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u0948\u0902 \u0924\u094b \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0932\u093f\u0916 \u0926\u094b \u091a\u0948\u0932\u0947\u0902\u091c \u090f\u0915\u0938\u093e\u092b\u094d\u091f\u0947\u091f \u0938\u092c \u0932\u094b\u0917 \u0932\u093f\u0916 \u0926\u0947 \u0928 \u0926\u0947\u0916\u094b \u0914\u0930 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u0932\u093e\u0907\u0915 \u092d\u0940 \u0915\u0930 \u0926\u0947\u0928\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092e\u0947\u0930\u0940 \u0907\u0928\u0930\u091c\u0940 \u0924\u094b \u0939\u093e\u0908 \u0939\u0948 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u0932\u0924\u0947 \u0939\u0948\u0902 \u0915\u0949\u092e\u094d\u092a\u094d\u092f\u0942\u091f\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u092e \u092e\u0947\u0902 \u0932\u0947\u091f\u094d\u0938 \u0930\u094b\u0932 \u0926\u0947 \u0907\u0902\u091f\u094d\u0930\u094b \u0906\u092a\u0915\u094b \u092c\u093f\u0932\u0947\u0917\u093e \u091c\u094b \u0928\u0940\u091a\u0947 \u0915\u0949\u092e\u0947\u0902\u091f \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091a\u0932\u0947\u0902\u091c \u090f\u0915\u0938\u093e\u092b\u094d\u091f\u0947\u091f \u0932\u093f\u0916\u0947\u0917\u093e \u0906\u092a\u0915\u094b \u092c\u0928\u093e\u0928\u093e \u0939\u0948 \u0907\u0938 \u092c\u0949\u0932\u094d\u091f\u0940 \u0915\u0932\u0930 \u0928\u0947\u0935\u093e\u092c\u093e\u0930 \u0915\u094b \u092c\u0928\u093e\u0928\u093e \u0939\u0948 \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u093e \u0939\u0942\u0901 \u092d\u0940 \u092f\u0939\u093e\u0902 \u092a\u0930 \u0915\u093f \u0939\u092e \u0926\u093f\u0930\u0947 \u0926\u093f\u0930\u0947 \u091f\u094d\u0930\u0936\u093f\u0936\u0928 \u0915\u0930\u0947\u0902\u0917\u0947 \u090f\u0915 \u092b\u0941\u0932 \u0935\u0947\u092c\u0938\u093e\u0907\u0921 \u092c\u0928\u093e\u0928\u0947 \u092a\u0930 \u0915\u0941\u091b \u0907\u0902\u092a\u094b\u0930\u094d\u091f\u0947\u0902\u091f \u0915\u0949\u0902\u0938\u0947\u092a\u094d\u091f \u0938\u0947 \u0935\u094b \u0915\u092c\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u091c\u0948\u0938\u0947 \u0915\u0940 \u092b\u094d\u0932\u0947\u0915\u094d\u0938 \u092c\u0949\u0915\u094d\u0938 \u0939\u094b \u0917\u092f\u093e \u0939 \u0935\u093e\u0932\u093e \u092a\u0930 \u0906\u092a\u0915\u094b \u0926\u094b\u0908 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0905\u092a\u0928\u0947 \u092a\u094d\u0932\u0947\u0932\u093f\u0938\u094d\u091f \u0906\u0916\u094d\u0938\u0947\u0938 \u0915\u0930 \u0932\u093f\u090f \u0939\u0948 \u0914\u0930 \u091c\u094b \u0938\u094b\u0930\u094d\u0938 \u0915\u094b\u0921 \u092c\u094b \u092c\u0940 \u0905\u092a\u0932\u094b\u0921 \u0939\u094b\u0924\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948 \u0924\u094b \u0909\u0938\u0915\u094b \u092d\u0940 \u0906\u092a \u0932\u094b\u0917 \u0906\u0916\u094d\u0938\u0947\u0938 \u091c\u093c\u0930\u0942\u0930 \u0915\u0930 \u0932\u0947\u0928\u093e \u0905\u092d\u0940 \u0917\u0932\u0947\u0938 \u0935\u0940\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u0917\u0948\u0938 \u0924\u0947\u0902\u0915\u093f\u092f\u094b \u0938\u094b \u092e\u0941\u091d \u0917\u0948\u0938 \u092a\u0930 \u0935\u093e\u091a\u093f\u0902\u0917 \u0907\u0938 \u0935\u0940\u0921\u093f\u092f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902"}